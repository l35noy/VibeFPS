extends Node3D

## Тир: корневой скрипт сцены, который готовит её к бою.
##
## Сцена запекает навмеш в рантайме, а не хранит запечённую сетку в файле.
## Причина не в экономии места, а в том, что запечённый навмеш — производная от
## геометрии: он мгновенно устаревает, как только в сцене двигают пол, стену или
## мишень, и устаревший навмеш выглядит как рабочий — навмеш на месте, слои на
## месте, а враг стоит столбом и не понимает почему. Спека §12 требует от
## агента, меняющего геометрию, перестроить навмеш в той же задаче, и bake в
## `_ready()` делает это автоматически: правило «агент ходит» не может
## разъехаться с правилом «мир ходим».
##
## Bake СИНХРОННЫЙ — `bake_navigation_mesh(false)`, а не `true`. Настоящий bake
## читает геометрию и считает Recast-сетку: на мире такого размера это десятки
## миллисекунд. Запущенный в отдельном потоке он вернул бы полупустую сетку и
## ушёл считать её после того, как первые кадры боя уже прошли, — то есть
## первая секунда игры шла бы вслепую. Синхронный bake кончается до первого
## физического шага, потому что `_ready()` корня отрабатывает раньше него.
##
## Ноль полигонов — это ошибка, а не пустой результат: идти по сетке без
## полигонов некуда, враг будет стоять, и ни один статический список
## утверждений этого не заметит. Поэтому bake проверяется здесь, на месте, и
## падает в консоль громко, а не остаётся молчаливым.
##
## Порядок в `_ready()` обязателен: сначала проверка, что bake вообще чему-то
## подлежит (регион и ресурс сетки на месте), и только потом сам bake — иначе
## ошибка «нет региона» пришла бы изнутри bake, как рантайм-трейс, который
## ничего не говорит о причине.
##
## Второе, что здесь важно и что не видно в коде: cell_height навмеша тира
## участвует в ПРАВИЛЕ ЗАМОРОЗКИ врага. Запечённая поверхность сетки лежит на
## `2 * cell_height` выше геометрии, а первая точка пути — это позиция агента,
## привязанная к сетке, то есть ровно на этом смещении выше пяток. Пока
## смещение не меньше `path_desired_distance` агента, агент не считает точку
## достигнутой, индекс точки пути не сдвигается никогда, и враг стоит на месте
## при запечённом, вполне достижимом навмеше. Тир держит `cell_height = 0.25`
## (смещение 0.5) против порога 1.0 — запас вдвое, и при этом сетка не мельче
## карты навигации проекта, о чём Godot предупреждает отдельно. Проверка
## неравенства живёт в tests/enemies.gd («Проводка сцены»), где видны оба
## числа: порог — в enemy_contact.tscn, смещение — здесь.

const _REGION_PATH := "NavigationRegion3D"


@onready var _region: NavigationRegion3D = get_node_or_null(_REGION_PATH) as NavigationRegion3D


func _ready() -> void:
	if _region == null:
		# Предупреждение-ошибка, а не тишина: тир без навмеша выглядит целым и
		# работает ровно до первого врага, который вместо того, чтобы идти,
		# просто стоит. Молчащий отказ выглядит как «враг не хочет идти».
		push_error("[range] %s: в сцене нет NavigationRegion3D — враг останется на месте" % name)
		return
	if _region.navigation_mesh == null:
		push_error("[range] %s: у NavigationRegion3D нет NavigationMesh — печь нечего" % name)
		return
	# Синхронный bake (false = не в отдельном потоке): см. шапку файла.
	_region.bake_navigation_mesh(false)
	var polygons := _region.navigation_mesh.get_polygon_count()
	if polygons == 0:
		push_error("[range] %s: bake навмеша не дал ни одного полигона — идти некуда, " % name
			+ "а враг будет стоять сломанным (проверь, что геометрия лежит ПОД регионом)")
