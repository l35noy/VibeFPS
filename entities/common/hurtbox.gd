class_name Hurtbox
extends Area3D

## Хитбокс: зона, в которую можно попасть.
##
## Здоровья здесь нет и не будет. Хитбокс только сообщает о попадании
## (`damage_taken`), а состояние здоровья живёт у того, кто этот хитбокс
## владеет — в Фазе 2 это враг или игрок. Если бы урон уменьшал поле внутри
## хитбокса, у каждого поражённого места появилось бы своё здоровье, и «у врага
## 100 HP» перестало бы быть правдой.

signal damage_taken(amount: float)

## Множитель урона. Обычный враг — 1.0. В Фазе 2 через это поле делается
## слабое место босса с ×2, поэтому контракт (умножение при нанесении, а не при
## поглощении) должен быть верным уже сейчас, даже пока его никто не читает.
@export var damage_multiplier: float = 1.0

## Зона хитбокса: 0 — враг (слой 4), 1 — игрок (слой 7). Одно поле вместо двух
## экспортов со слоями потому, что слой и логика должны лежать в одном файле:
## свободная пара «слой — маска» в инспекторе разъезжается с кодом молча, и
## мишень, поставленная на слой 4, продолжает ловить выстрелы, которые смотрит
## на слой 7.
@export_enum("enemy_hurtbox", "player_hurtbox") var zone: int = 0
## Обнаруживать ли пересечения самому хитбоксу. Врагу это нужно для контактного
## урона: он сам ищет, кого коснулся. Игроку не нужно — детект включается на
## стороне врага (спека §6.3), иначе хитбокс игрока начал бы ловить и вражеские
## хитбоксы, и мир, что ему не требуется.
@export var detects_contact: bool = false


## Слои и маски задаются здесь, а не в сцене: правило «кого я ловлю» и логика
## попадания лежат в одном файле, и сцена не может их разъехать.
##
## Маска при детекте — слой 7, а не слой 1 (мир): обнаруживающему хитбоксу нужно
## ровно одно — хитбокс игрока. Мир (`area_entered` его и не ловит, ведь это
## StaticBody3D) контактному урону не нужен, а лишний слой в маске означал бы
## запросы, результат которых всё равно игнорируется.
func _ready() -> void:
	collision_layer = (1 << 3) if zone == 0 else (1 << 6)
	monitoring = detects_contact
	collision_mask = (1 << 6) if detects_contact else (1 << 0)
	# Обнаруживаемым хитбокс обязан быть всегда — без этого снаряд, который его
	# ищет, его не увидит. А вот monitoring остаётся выключенным по умолчанию:
	# чистой цели нечего искать самой, и её собственные пересечения только тратят
	# время на запросы.
	monitorable = true


## Сообщить попадание. Ничего не меняет в собственном состоянии: ни здоровья,
## ни «уже полученного урона» здесь нет.
func apply_damage(amount: float) -> void:
	damage_taken.emit(amount * damage_multiplier)
